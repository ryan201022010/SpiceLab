{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"SpiceLab","text":""},{"location":"#_1","title":"\u5c08\u984c\u67b6\u69cb\u898f\u5283","text":"<ul> <li> <p>Lab 1\uff1a\u57fa\u790e\u5143\u4ef6\u8207\u96fb\u8def\u5b78\uff08The Foundation\uff09</p> <ul> <li>\u4ecb\u7d39\u57fa\u672c\u96fb\u8def\u5143\u4ef6\uff08\u96fb\u963b\u3001\u96fb\u5bb9\u3001\u96fb\u611f\uff09\u8207 KCL/KVL \u7b49\u6838\u5fc3\u7406\u8ad6</li> </ul> </li> <li> <p>Lab 2\uff1aLTspice \u865b\u64ec\u5be6\u9a57\uff08Simulation Guide\uff09</p> <ul> <li>\u5f15\u5c0e\u4f7f\u7528\u8005\u5c07\u7406\u8ad6\u756b\u6210\u96fb\u8def\u5716</li> <li>\u9032\u884c\u5de5\u4f5c\u9ede\uff08.op\uff09\u548c\u983b\u7387\u97ff\u61c9\uff08.ac\uff09\u6a21\u64ec\uff0c\u9a57\u8b49\u7406\u8ad6</li> </ul> </li> <li> <p>Lab 3\uff1aPyLTSpice \u81ea\u52d5\u5316\u7814\u767c\uff08Automation &amp; Extension\uff09</p> <ul> <li>\u7528 Python \u5beb\u7a0b\u5f0f\uff0c\u81ea\u52d5\u66f4\u6539 LTspice \u7684\u5143\u4ef6\u6578\u503c\u3001\u6279\u6b21\u57f7\u884c\u6a21\u64ec</li> <li>\u7528 Python \u756b\u51fa\u6f02\u4eae\u7684\u5206\u6790\u5716\u8868</li> </ul> </li> </ul>"},{"location":"#_2","title":"\u53c3\u8003\u8cc7\u6e90","text":"<ul> <li> <p>LTspice{target=_blank}</p> </li> <li> <p>PyLTspice{target=_blank}</p> </li> </ul>"},{"location":"about/","title":"\u95dc\u65bc\u5c08\u984c","text":""},{"location":"about/#_2","title":"\u4f5c\u8005","text":"<p>Ryan Chen</p>"},{"location":"about/#_3","title":"\u5c08\u984c\u7c21\u4ecb","text":"<p>\u4e00\u500b\u53ef\u4ee5\u8b93\u4f7f\u7528\u8005\u9032\u884c\u53c3\u6578\u8abf\u6574\u8207\u81ea\u52d5\u5316\u6e2c\u8a66\u7684\u300c\u865b\u64ec\u96fb\u8def\u5be6\u9a57\u5de5\u5177\u300d</p>"},{"location":"ch01/","title":"\u96fb\u8def\u5b78\u57fa\u790e","text":""},{"location":"ch01/#_2","title":"\u4e00\u3001 \u96fb\u6d41\u8207\u96fb\u52d5\u52e2","text":"<ul> <li> <p>\u6838\u5fc3\u89c0\u5ff5\uff1a\u5fae\u89c0\u5c0e\u96fb\u6a21\u578b \\(I = nAev_d\\) \u3001\u96fb\u52d5\u52e2 \\(\\varepsilon\\) \u8207\u7aef\u96fb\u7dda \\(V = \\varepsilon - Ir\\) \u5340\u5206\u975e\u7406\u60f3\u96fb\u6c60\u5167\u90e8\u7684\u5316\u5b78\u63a8\u52d5\u529b\u8207\u5167\u96fb\u963b\u58d3\u964d</p> </li> <li> <p>\u5fae\u89c0\u52d5\u756b (HTML5 Canvas/P5.js)\uff1a\u52d5\u614b\u5c55\u793a\u91d1\u5c6c\u5c0e\u9ad4\u5167\uff0c\u81ea\u7531\u96fb\u5b50\u5728\u4e0d\u52a0\u96fb\u58d3\u6642\u7684\u96a8\u6a5f\u71b1\u904b\u52d5\uff0c\u4ee5\u53ca\u52a0\u4e0a\u96fb\u58d3\u5f8c \u514b\u670d\u6676\u683c\u78b0\u649e\u7522\u751f\u7684\u5b9a\u5411\u300c\u6f02\u79fb\u901f\u7387 \\(v_{d}\\) \u300d</p> </li> <li> <p>\u6ed1\u687f\u8b8a\u6578\u63a7\u5236\uff1a\u8b93\u4f7f\u7528\u8005\u8abf\u6574\u8f09\u6d41\u5b50\u5bc6\u5ea6 \\(n\\) \u6216\u622a\u9762\u7a4d \\(A\\) \u52d5\u614b\u89c0\u5bdf\u96fb\u6d41 \\(I\\) \u7684\u6578\u64da\u8b8a\u5316</p> </li> </ul>"},{"location":"ch01/#_3","title":"\u4e8c\u3001 \u96fb\u963b\u8207\u6b50\u59c6\u5b9a\u5f8b","text":"<ul> <li> <p>\u6838\u5fc3\u89c0\u5ff5\uff1a\u6b50\u59c6\u5b9a\u5f8b\u7684\u9069\u7528\u689d\u4ef6\uff08\u7dda\u6027\u5143\u4ef6 \\(V=IR\\) \uff09\u3001\u96fb\u963b\u5b9a\u5f8b \\(R = \\rho\\frac{L}{A}\\) \uff0c\u4ee5\u53ca\u96fb\u963b\u7387\u8207\u6eab\u5ea6\u7684\u7dda\u6027\u95dc\u4fc2 \\(R = R_0(1+\\alpha \\Delta T)\\)</p> </li> <li> <p>\u5e7e\u4f55\u91cd\u5851\u8996\u89ba\u5316\uff1a\u8a2d\u8a08\u4e00\u500b\u53ef\u62d6\u66f3\u62c9\u9577\u7684\u5c0e\u7dda 3D \u6216 2D \u5716\u50cf\uff0c\u7576\u4f7f\u7528\u8005\u628a\u5c0e\u7dda\u300c\u62c9\u9577\u300d\u6216\u300c\u8b8a\u7d30\u300d\u6642\uff0c\u5716\u50cf\u5373\u6642\u6539\u8b8a\uff0c\u4e26\u52d5\u614b\u66f4\u65b0\u96fb\u963b\u503c</p> </li> <li> <p>\u6eab\u5ea6\u6548\u61c9\u5716\u8868\uff1a\u52a0\u5165\u6eab\u5ea6\u6ed1\u687f\uff0c\u5373\u6642\u5728\u5716\u8868\u4e0a\u7e6a\u88fd\u51fa\u975e\u6b50\u59c6\u5c0e\u9ad4\uff08\u5982\u93a2\u7d72\u71c8\u6ce1\uff09\u8207\u4e00\u822c\u96fb\u963b\u7684 \\(V-I\\) \u7279\u6027\u66f2\u7dda\u5dee\u7570</p> </li> </ul>"},{"location":"ch01/#_4","title":"\u4e09\u3001 \u96fb\u8def\u5206\u6790\u8207\u5b88\u6046\u5b9a\u5f8b","text":"<ul> <li> <p>\u6838\u5fc3\u89c0\u5ff5\uff1a\u514b\u5e0c\u8377\u592b\u7b2c\u4e00\u5b9a\u5f8b\uff08\u7bc0\u9ede\u96fb\u6d41\u5b88\u6046\uff0c\u96fb\u8377\u5b88\u6046\uff09\u8207\u7b2c\u4e8c\u5b9a\u5f8b\uff08\u8ff4\u8def\u96fb\u4f4d\u5347\u964d\u4ee3\u6578\u548c\u70ba\u96f6\uff0c\u80fd\u91cf\u5b88\u6046\uff09 \u57fa\u672c\u7684\u4e32\u806f\u5206\u58d3\u8207\u4e26\u806f\u5206\u6d41\u539f\u7406</p> </li> <li> <p>\u8996\u89ba\u5316\u96fb\u4f4d\u968e\u68af\u5716\uff1a\u5728\u8907\u96dc\u96fb\u8def\u7684\u4e0b\u65b9\uff0c\u540c\u6b65\u7e6a\u88fd\u51fa\u5c0d\u61c9\u7684\u300c\u96fb\u4f4d\u9ad8\u5ea6\u8b8a\u5316\u5716\uff08\u9ad8\u4f4e\u8d77\u4f0f\u7684\u968e\u68af\uff09\u300d\uff0c\u5e6b\u52a9\u5b78\u751f\u76f4\u89c0\u7406\u89e3\u300c\u7e5e\u4e00\u5708\u96fb\u4f4d\u4ee3\u6578\u548c\u70ba\u96f6\u300d\u7684\u80fd\u91cf\u89c0\u5ff5</p> </li> <li> <p>\u7bc0\u9ede\u6d41\u901f\u6307\u793a\uff1a\u5728\u96fb\u8def\u7bc0\u9ede\u8655\u4ee5\u5c0f\u6c34\u6d41\u6216\u7c97\u7d30\u7bad\u982d\u52d5\u614b\u6a19\u793a\u96fb\u6d41\u5206\u914d\uff0c\u9a57\u8b49\u6d41\u5165\u7b49\u65bc\u6d41\u51fa</p> </li> </ul>"},{"location":"ch01/#_5","title":"\u56db\u3001 \u96fb\u529f\u7387\u8207\u80fd\u91cf","text":"<ul> <li> <p>\u6838\u5fc3\u89c0\u5ff5\uff1a\u514b\u5e0c\u8377\u592b\u7b2c\u4e00\u5b9a\u5f8b\uff08\u7bc0\u9ede\u96fb\u6d41\u5b88\u6046\uff0c\u96fb\u8377\u5b88\u6046\uff09\u8207\u7b2c\u4e8c\u5b9a\u5f8b\uff08\u8ff4\u8def\u96fb\u4f4d\u5347\u964d\u4ee3\u6578\u548c\u70ba\u96f6\uff0c\u80fd\u91cf\u5b88\u6046\uff09 \u57fa\u672c\u7684\u4e32\u806f\u5206\u58d3\u8207\u4e26\u806f\u5206\u6d41\u539f\u7406</p> </li> <li> <p>\u8996\u89ba\u5316\u96fb\u4f4d\u968e\u68af\u5716\uff1a\u5728\u8907\u96dc\u96fb\u8def\u7684\u4e0b\u65b9\uff0c\u540c\u6b65\u7e6a\u88fd\u51fa\u5c0d\u61c9\u7684\u300c\u96fb\u4f4d\u9ad8\u5ea6\u8b8a\u5316\u5716\uff08\u9ad8\u4f4e\u8d77\u4f0f\u7684\u968e\u68af\uff09\u300d\uff0c\u5e6b\u52a9\u5b78\u751f\u76f4\u89c0\u7406\u89e3\u300c\u7e5e\u4e00\u5708\u96fb\u4f4d\u4ee3\u6578\u548c\u70ba\u96f6\u300d\u7684\u80fd\u91cf\u89c0\u5ff5</p> </li> <li> <p>\u7bc0\u9ede\u6d41\u901f\u6307\u793a\uff1a\u5728\u96fb\u8def\u7bc0\u9ede\u8655\u4ee5\u5c0f\u6c34\u6d41\u6216\u7c97\u7d30\u7bad\u982d\u52d5\u614b\u6a19\u793a\u96fb\u6d41\u5206\u914d\uff0c\u9a57\u8b49\u6d41\u5165\u7b49\u65bc\u6d41\u51fa</p> </li> </ul>"},{"location":"ch01/#_6","title":"\u4e94\u3001 \u8907\u96dc\u96fb\u8def\u8207\u5100\u8868","text":"<ul> <li> <p>\u6838\u5fc3\u89c0\u5ff5\uff1a\u60e0\u65af\u540c\u96fb\u6a4b\u7684\u5e73\u8861\u8207\u6e2c\u91cf\u3001\u6aa2\u6d41\u8a08\u6539\u88dd\u6210\u5b89\u57f9\u8a08\uff08\u4e26\u806f\u5c0f\u96fb\u963b\u5206\u6d41\uff09\u8207\u4f0f\u7279\u8a08\uff08\u4e32\u806f\u5927\u96fb\u963b\u500d\u58d3\uff09\u7684\u96fb\u8def\u539f\u7406</p> </li> <li> <p>\u96fb\u8868\u6539\u88dd\u6c99\u76d2 (Sandbox)\uff1a\u63d0\u4f9b\u4e00\u500b\u57fa\u672c\u7684\u5fae\u5b89\u57f9\u8a08\u8a08\u982d\uff0c\u8b93\u4f7f\u7528\u8005\u81ea\u884c\u300c\u6253\u5b57\u8f38\u5165\u300d\u6216\u300c\u62d6\u66f3\u9023\u63a5\u300d\u5206\u6d41/\u500d\u58d3\u96fb\u963b \u82e5\u8f38\u5165\u932f\u8aa4\u7684\u963b\u503c\uff0c\u865b\u64ec\u96fb\u8868\u6703\u51fa\u73fe\u300c\u6307\u91dd\u7206\u8868\u7834\u8868\u300d\u6216\u300c\u71d2\u6bc0\u300d\u7684\u8b66\u793a\u52d5\u756b</p> </li> <li> <p>\u6ed1\u52d5\u8b8a\u963b\u5668\u6e2c\u672a\u77e5\u96fb\u963b\uff1a\u6a21\u64ec\u60e0\u65af\u540c\u96fb\u6a4b\u5be6\u9a57\uff0c\u4f7f\u7528\u8005\u53ef\u62d6\u66f3\u6ed1\u584a\u76f4\u5230\u6aa2\u6d41\u8a08\u8b80\u6578\u6b78\u96f6\uff0c\u85c9\u6b64\u7df4\u7fd2\u63a8\u5c0e\u516c\u5f0f</p> </li> </ul>"},{"location":"ch01/#rc","title":"\u516d\u3001 \u96fb\u5bb9\u8207 RC \u96fb\u8def\u66ab\u614b","text":"<ul> <li> <p>\u6838\u5fc3\u89c0\u5ff5\uff1a\u96fb\u5bb9\u5668\u7684\u5132\u80fd\u539f\u7406 \\(Q=CV\\) \u3001 \\(RC\\) \u96fb\u8def\u5145\u96fb\u8207\u653e\u96fb\u6642\uff0c\u96fb\u8377\u3001\u96fb\u58d3\u3001\u96fb\u6d41\u96a8\u6642\u9593\u5448\u6307\u6578\u8b8a\u5316\u7684\u66ab\u614b\u904e\u7a0b\uff0c\u4ee5\u53ca\u6642\u9593\u5e38\u6578 \\(\\tau = RC\\) \u7684\u7269\u7406\u610f\u7fa9</p> </li> <li> <p>\u52d5\u614b\u793a\u6ce2\u5668 (Oscilloscope Simulation)\uff1a\u7576\u4f7f\u7528\u8005\u9ede\u64ca\u300c\u5207\u63db\u958b\u95dc\uff08\u5145\u96fb/\u653e\u96fb\uff09\u300d\u6642\uff0c\u7a0b\u5f0f\u6703\u4ee5\u52d5\u614b\u6642\u5e8f\u7e6a\u88fd\u51fa\u96fb\u58d3\uff08\u6216\u96fb\u6d41\uff09\u96a8\u6642\u9593\u8b8a\u5316\u7684\u6f38\u9032\u66f2\u7dda \\(1-e^{-t/RC}\\)</p> </li> <li> <p>\u5feb\u6162\u901f\u66ab\u614b\u8abf\u6574\uff1a\u8abf\u6574\u96fb\u5bb9 \\(C\\) \u6216\u96fb\u963b \\(R\\) \u7684\u6578\u503c\uff0c\u4f7f\u7528\u8005\u80fd\u7acb\u523b\u770b\u5230\u793a\u6ce2\u5668\u4e0a\u7684\u6ce2\u5f62\u8b8a\u9661\u5ced\uff08\u5145\u96fb\u8b8a\u5feb\uff09\u6216\u8b8a\u5e73\u7de9\uff08\u5145\u96fb\u8b8a\u6162\uff09</p> </li> </ul>"},{"location":"ch02/","title":"LTspice","text":""},{"location":"ch03/","title":"PyLTspice","text":""}]}